# Copy to .env.production, replace every placeholder, then chmod 600.
COMPOSE_PROJECT_NAME=sangfor-production
API_IMAGE=sangfor-api
WEB_IMAGE=sangfor-web
APP_DOMAIN=sangfor.example.com
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DB=sangfor_os
POSTGRES_PASSWORD=replace_with_32_char_url_safe_secret
SANGFOR_APP_DB_PASSWORD=replace_with_different_32_char_secret
SANGFOR_RUNTIME_DB_PASSWORD=replace_with_different_32_char_secret
REDIS_PASSWORD=replace_with_different_32_char_secret
BACKUP_DIR=/var/backups/sangfor-os
DEFAULT_TENANT_ID=replace_with_production_tenant_id
DEFAULT_COMPANY_ID=replace_with_production_company_id
DEFAULT_PROJECT_ID=replace_with_production_project_id
DEFAULT_PROJECT_SLUG=replace_with_production_project_slug
PRODUCTION_APPROVAL_ISSUER=replace_with_trusted_release_issuer
PRODUCTION_APPROVAL_PUBLIC_KEYS_JSON={"release-key-2026-01":{"publicKeyPem":"replace_with_ed25519_public_key_pem","status":"verify"}}

API_KEY=replace_with_operator_api_key_32_chars
FINANCE_API_KEY=replace_with_finance_api_key_32_chars
SANGFOR_API_KEY=replace_with_engineer_api_key_32_chars
SANGFOR_OPERATOR_PRINCIPAL_ID=replace_with_server_owned_operator_id
JWT_SECRET=replace_with_dashboard_hash_secret_32_chars

USER_JWT_ACTIVE_KID=prod-user-jwt-2026-01
USER_JWT_KEYRING_JSON={"version":"sangfor.user-jwt-keyring/v1","keys":[{"kid":"prod-user-jwt-2026-01","state":"active","secretBase64Url":"replace_with_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verifyUntil":null,"retiredAt":null}]}
USER_JWT_ISSUER=sangfor-os
USER_JWT_AUDIENCE=sangfor-os-runtime
USER_JWT_TTL_SECONDS=900
USER_JWT_CLOCK_SKEW_SECONDS=30

INTERNAL_PRINCIPAL_FINANCE_ACTIVE_KID=prod-finance-2026-01
INTERNAL_PRINCIPAL_FINANCE_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","profile":"FINANCE","keys":[{"kid":"prod-finance-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verifyUntil":null,"retiredAt":null}]}
INTERNAL_PRINCIPAL_SCHEDULER_ACTIVE_KID=prod-scheduler-2026-01
INTERNAL_PRINCIPAL_SCHEDULER_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","profile":"SCHEDULER","keys":[{"kid":"prod-scheduler-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verifyUntil":null,"retiredAt":null}]}
INTERNAL_PRINCIPAL_WORKFLOW_ACTIVE_KID=prod-workflow-2026-01
INTERNAL_PRINCIPAL_WORKFLOW_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","profile":"WORKFLOW","keys":[{"kid":"prod-workflow-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verifyUntil":null,"retiredAt":null}]}
INTERNAL_PRINCIPAL_ENGINEER_ACTIVE_KID=prod-engineer-2026-01
INTERNAL_PRINCIPAL_ENGINEER_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","profile":"ENGINEER","keys":[{"kid":"prod-engineer-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verifyUntil":null,"retiredAt":null}]}
EXTERNAL_ACTION_RECEIPT_ACTIVE_KEY_ID=prod-external-action-2026-01
