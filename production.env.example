# Copy to .env.production, replace every placeholder, then chmod 600.
COMPOSE_PROJECT_NAME=sangfor-production
API_IMAGE=sangfor-api
WEB_IMAGE=sangfor-web
APP_DOMAIN=sangfor.example.com
TAILSCALE_DOMAIN=blro.example-tailnet.ts.net
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DB=sangfor_os
POSTGRES_PASSWORD=replace_with_32_char_url_safe_secret
SANGFOR_APP_DB_PASSWORD=replace_with_different_32_char_secret
SANGFOR_RUNTIME_DB_PASSWORD=replace_with_different_32_char_secret
REDIS_PASSWORD=replace_with_different_32_char_secret
BACKUP_DIR=/var/backups/sangfor-os
# Fixed bootstrap identities. Choose unique production values before the first deployment.
DEFAULT_TENANT_ID=tenant-prod-001
DEFAULT_TENANT_SLUG=tenant-prod-001
DEFAULT_COMPANY_ID=company-prod-001
DEFAULT_COMPANY_SLUG=company-prod-001
DEFAULT_PROJECT_ID=project-prod-001
DEFAULT_PROJECT_SLUG=project-prod-001
# Fixed initial operator identity. Supply a real, unique lowercase address before deployment.
PRODUCTION_OPERATOR_USER_ID=operator-prod-001
PRODUCTION_OPERATOR_EMAIL=operator-prod-001@sangfor.invalid
API_KEY=replace_with_operator_api_key_32_chars
FINANCE_API_KEY=replace_with_finance_api_key_32_chars
SANGFOR_API_KEY=replace_with_engineer_api_key_32_chars
SANGFOR_OPERATOR_PRINCIPAL_ID=replace_with_server_owned_operator_id
JWT_SECRET=replace_with_dashboard_hash_secret_32_chars

USER_JWT_ACTIVE_KID=prod-user-jwt-2026-01
USER_JWT_KEYRING_JSON={"version":"sangfor.user-jwt-keyring/v1","keys":[{"kid":"prod-user-jwt-2026-01","state":"active","secretBase64Url":"replace_with_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verifyUntil":null,"retiredAt":null}]}
USER_JWT_ISSUER=sangfor-os
USER_JWT_AUDIENCE=sangfor-os-runtime
USER_JWT_TTL_SECONDS=28800
USER_JWT_CLOCK_SKEW_SECONDS=30

INTERNAL_PRINCIPAL_FINANCE_ACTIVE_KID=prod-finance-2026-01
INTERNAL_PRINCIPAL_FINANCE_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","keys":[{"kid":"prod-finance-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verificationCutoff":null,"retiredAt":null}]}
INTERNAL_PRINCIPAL_SCHEDULER_ACTIVE_KID=prod-scheduler-2026-01
INTERNAL_PRINCIPAL_SCHEDULER_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","keys":[{"kid":"prod-scheduler-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verificationCutoff":null,"retiredAt":null}]}
INTERNAL_PRINCIPAL_WORKFLOW_ACTIVE_KID=prod-workflow-2026-01
INTERNAL_PRINCIPAL_WORKFLOW_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","keys":[{"kid":"prod-workflow-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verificationCutoff":null,"retiredAt":null}]}
INTERNAL_PRINCIPAL_ENGINEER_ACTIVE_KID=prod-engineer-2026-01
INTERNAL_PRINCIPAL_ENGINEER_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","keys":[{"kid":"prod-engineer-2026-01","state":"active","secretBase64Url":"replace_with_a_different_32_random_bytes_base64url","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verificationCutoff":null,"retiredAt":null}]}
EXTERNAL_ACTION_RECEIPT_ACTIVE_KEY_ID=prod-external-action-2026-01
EXTERNAL_ACTION_RECEIPT_KEYS_JSON={"prod-external-action-2026-01":{"secret":"replace_with_a_different_32_random_bytes_base64url","status":"sign_verify","signingDisabledAt":null}}
