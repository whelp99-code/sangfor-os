  artifact                 Artifact              @relation("ArtifactVersions", fields: [artifactId], references: [id], onDelete: Restrict, map: "artifact_versions_artifact_id_fkey")
  currentForArtifact       Artifact?             @relation("ArtifactCurrentVersion")
  // U018/APR-01a: required Prisma back-relation for ApprovalRequest.artifactVersionId — same
