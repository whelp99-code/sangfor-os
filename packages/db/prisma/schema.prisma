model Subscription {
  id        String    @id @default(cuid())
  assetId   String    @map("asset_id")
  skuId     String    @map("sku_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  status    String    @default("active")
  autoRenew Boolean   @default(false) @map("auto_renew")
  deliveryAcceptanceId  String?   @map("delivery_acceptance_id")
  assetLicenseId        String?   @map("asset_license_id")
  sourceQuoteLineItemId String?   @map("source_quote_line_item_id")
  createdAt             DateTime? @map("created_at")
  updatedAt             DateTime? @map("updated_at")

  asset CustomerAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sku   ProductSku    @relation(fields: [skuId], references: [id])
  deliveryAcceptance DeliveryAcceptance? @relation("SubscriptionDeliveryAcceptance", fields: [deliveryAcceptanceId], references: [id], onDelete: Restrict, map: "subscriptions_delivery_acceptance_id_fkey")
  assetLicense AssetLicense? @relation("SubscriptionAssetLicense", fields: [assetLicenseId], references: [id], onDelete: Restrict, map: "subscriptions_asset_license_id_fkey")
  sourceQuoteLineItem QuoteLineItem? @relation("SubscriptionSourceQuoteLineItem", fields: [sourceQuoteLineItemId], references: [id], onDelete: Restrict, map: "subscriptions_source_quote_line_item_id_fkey")
