  submissionEvidenceArtifactVersion ArtifactVersion? @relation("VendorEscalationSubmissionEvidenceArtifactVersion", fields: [submissionEvidenceArtifactVersionId], references: [id], onDelete: Restrict, map: "vendor_escalations_submission_evidence_artifact_version_id_fkey")

  @@index([caseId], map: "vendor_escalations_case_id_idx")
  @@index([submissionEvidenceArtifactVersionId], map: "vendor_escalations_submission_evidence_artifact_version_id_idx")
  @@index([status, updatedAt], map: "vendor_escalations_status_updated_at_idx")
