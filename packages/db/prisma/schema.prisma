// --- Delivery ---

// Engagement = the project an Opportunity converts into once a POC plan is
// confirmed with the customer. Renamed from DeliveryProject (table preserved via
// @@map). Absorbs proposals / POC / meetings / quote-derived amount.
model Engagement {
  id                 String    @id @default(cuid())
  opportunityId      String    @unique @map("opportunity_id")
  projectId          String?   @map("project_id")
  customerId         String?   @map("customer_id")
  name               String
  status             String    @default("planned")
  amount             Decimal?  @db.Decimal(12, 2)
  amountQuoteId      String?   @map("amount_quote_id")
  summaryMarkdown    String?   @map("summary_markdown")
  convertedAt        DateTime? @map("converted_at")
  convertedFromStage String?   @map("converted_from_stage")
  sowApprovedAt      DateTime? @map("sow_approved_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")

  opportunity        Opportunity            @relation(fields: [opportunityId], references: [id])
  checklistItems     DeliveryChecklistItem[]
  generatedDocuments GeneratedDocument[]
  meetingNotes       MeetingNote[]
  invoices           Invoice[]
  expenses           Expense[]
  taxInvoices        TaxInvoice[]
  deliveryAcceptances DeliveryAcceptance[] @relation("DeliveryAcceptanceEngagement")
  capabilityRequirements EngagementCapabilityRequirement[] @relation("EngagementCapabilityRequirementEngagement")

  @@map("delivery_projects")
}

// Immutable, idempotent acceptance evidence. Runtime projection is intentionally deferred to U051.
model DeliveryAcceptance {
  id                     String   @id @default(cuid())
  engagementId           String   @unique(map: "delivery_acceptances_engagement_id_key") @map("engagement_id")
  quoteId                String   @map("quote_id")
  artifactVersionId      String   @map("artifact_version_id")
  acceptedByAssignmentId String   @map("accepted_by_assignment_id")
  acceptedAt             DateTime @map("accepted_at")
  acceptanceHash         String   @map("acceptance_hash")
  snapshotJson           Json     @map("snapshot_json")
  idempotencyKey         String   @unique(map: "delivery_acceptances_idempotency_key_key") @map("idempotency_key")
  createdAt              DateTime @default(now()) @map("created_at")

  engagement           Engagement      @relation("DeliveryAcceptanceEngagement", fields: [engagementId], references: [id], onDelete: Restrict, map: "delivery_acceptances_engagement_id_fkey")
  quote                Quote           @relation("DeliveryAcceptanceQuote", fields: [quoteId], references: [id], onDelete: Restrict, map: "delivery_acceptances_quote_id_fkey")
  artifactVersion      ArtifactVersion @relation("DeliveryAcceptanceArtifactVersion", fields: [artifactVersionId], references: [id], onDelete: Restrict, map: "delivery_acceptances_artifact_version_id_fkey")
  acceptedByAssignment UserCompanyRole @relation("DeliveryAcceptanceAcceptedByAssignment", fields: [acceptedByAssignmentId], references: [id], onDelete: Restrict, map: "delivery_acceptances_accepted_by_assignment_id_fkey")
  customerAssets       CustomerAsset[] @relation("CustomerAssetDeliveryAcceptance")
  assetLicenses        AssetLicense[]  @relation("AssetLicenseDeliveryAcceptance")
  subscriptions        Subscription[]  @relation("SubscriptionDeliveryAcceptance")

  @@index([quoteId], map: "delivery_acceptances_quote_id_idx")
  @@index([artifactVersionId], map: "delivery_acceptances_artifact_version_id_idx")
  @@index([acceptedByAssignmentId], map: "delivery_acceptances_accepted_by_assignment_id_idx")
  @@map("delivery_acceptances")
}

model DeliveryChecklistItem {
  id          String    @id @default(cuid())
  deliveryId  String    @map("delivery_id")
  itemKey     String    @map("item_key")
  status      String    @default("pending")
  completedAt DateTime? @map("completed_at")

  delivery Engagement @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_checklist_items")
}

// Meeting notes (미팅내용). Manually authored or promoted from a mail thread.
// Absorbed into an Engagement on conversion. `@@unique` keeps thread-promotion idempotent.
model MeetingNote {
  id                  String    @id @default(cuid())
  opportunityId       String?   @map("opportunity_id")
  engagementId        String?   @map("engagement_id")
  customerId          String?   @map("customer_id")
  mailInsightThreadId String?   @map("mail_insight_thread_id")
  title               String
  occurredAt          DateTime? @map("occurred_at")
  attendees           String[]  @default([])
  bodyMarkdown        String    @map("body_markdown")
  source              String    @default("manual")
  status              String    @default("confirmed")
  createdAt           DateTime  @default(now()) @map("created_at")

  engagement Engagement? @relation(fields: [engagementId], references: [id])

  @@unique([opportunityId, mailInsightThreadId])
  @@index([opportunityId])
  @@index([engagementId])
  @@map("meeting_notes")
}

// --- Support ---

model SupportCase {
  id                    String    @id @default(cuid())
  customerId            String    @map("customer_id")
  subject               String
  severity              String    @default("medium")
  status                String    @default("open")
  slaDeadline           DateTime? @map("sla_deadline")
  assignedTo            String?   @map("assigned_to")
  assetId               String?   @map("asset_id")
  ownerAssignmentId     String?   @map("owner_assignment_id")
  ownershipRevision     Int       @default(0) @map("ownership_revision")
  revision              Int       @default(0)
  respondedAt           DateTime? @map("responded_at")
  resolvedAt            DateTime? @map("resolved_at")
  closedAt              DateTime? @map("closed_at")
  rcaArtifactVersionId  String?   @map("rca_artifact_version_id")
  rcaRequiredAt         DateTime? @map("rca_required_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict, map: "support_cases_customer_id_fkey")
  asset              CustomerAsset?          @relation("SupportCaseAsset", fields: [assetId], references: [id], onDelete: Restrict, map: "support_cases_asset_id_fkey")
  ownerAssignment    UserCompanyRole?        @relation("SupportCaseOwnerAssignment", fields: [ownerAssignmentId], references: [id], onDelete: Restrict, map: "support_cases_owner_assignment_id_fkey")
  rcaArtifactVersion ArtifactVersion?        @relation("SupportCaseRcaArtifactVersion", fields: [rcaArtifactVersionId], references: [id], onDelete: Restrict, map: "support_cases_rca_artifact_version_id_fkey")
  slaSnapshot        SupportCaseSlaSnapshot?
  vendorEscalations  VendorEscalation[]

  @@index([customerId], map: "support_cases_customer_id_idx")
  @@index([status, severity])
  @@index([assetId], map: "support_cases_asset_id_idx")
  @@index([ownerAssignmentId, ownershipRevision], map: "support_cases_owner_assignment_id_ownership_revision_idx")
  @@index([rcaArtifactVersionId], map: "support_cases_rca_artifact_version_id_idx")
  @@map("support_cases")
}

model SupportCaseSlaSnapshot {
  id                      String   @id @default(cuid())
  supportCaseId           String   @unique @map("support_case_id")
  policyVersionId         String   @map("policy_version_id")
  severity                String
  responseMinutes         Int      @map("response_minutes")
  resolutionMinutes       Int      @map("resolution_minutes")
