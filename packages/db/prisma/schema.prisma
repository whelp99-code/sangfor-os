  archivedAt       DateTime? @map("archived_at")

  // U039 keeps the legacy policy record unscoped in the inventory until U040 proves every
  // historic row can be assigned a canonical company. New writes are DB-guarded instead.
  company        Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "support_sla_policies_company_id_fkey")
  currentVersion SupportSlaPolicyVersion? @relation("SupportSlaPolicyCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict, map: "support_sla_policies_current_version_id_fkey")
  versions       SupportSlaPolicyVersion[] @relation("SupportSlaPolicyVersions")

  @@unique([id, companyId], map: "support_sla_policies_id_company_id_key")
  @@index([companyId], map: "support_sla_policies_company_id_idx")
  @@index([currentVersionId], map: "support_sla_policies_current_version_id_idx")
  @@map("support_sla_policies")
}

// U039 policy versions carry the direct company anchor intentionally. It is a transitional
// canonical boundary, not a redundant child scope: the parent policy remains legacy-unscoped
// until U040's zero-null/zero-ambiguity proof.
model SupportSlaPolicyVersion {
  id                      String   @id @default(cuid())
  companyId               String   @map("company_id")
  policyId                String   @map("policy_id")
  version                 Int
  severity                String
  responseMinutes         Int      @map("response_minutes")
  resolutionMinutes       Int      @map("resolution_minutes")
  vendorEscalationMinutes Int?     @map("vendor_escalation_minutes")
  customerUpdateMinutes   Int?     @map("customer_update_minutes")
