  activeCompatibilityRules CompatibilityRule[]   @relation("CompatibilityRuleActiveArtifactVersion")
  provenanceQuotes         Quote[]               @relation("QuoteArtifactVersion")
  sizingQuoteLineItems     QuoteLineItem[]       @relation("QuoteLineSizingArtifactVersion")
  submissionEvidenceVendorRequests VendorRequest[] @relation("VendorRequestSubmissionEvidenceArtifactVersion")
