  ownerAssignment                   UserCompanyRole? @relation("VendorRequestOwnerAssignment", fields: [ownerAssignmentId], references: [id], onDelete: Restrict, map: "vendor_requests_owner_assignment_id_fkey")
  submissionEvidenceArtifactVersion ArtifactVersion? @relation("VendorRequestSubmissionEvidenceArtifactVersion", fields: [submissionEvidenceArtifactVersionId], references: [id], onDelete: Restrict, map: "vendor_requests_submission_evidence_artifact_version_id_fkey")
