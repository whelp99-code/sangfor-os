  @@index([status])
  @@index([assetId], map: "renewal_opportunities_asset_id_idx")
  @@index([subscriptionId], map: "renewal_opportunities_subscription_id_idx")
  @@index([opportunityId], map: "renewal_opportunities_opportunity_id_idx")
  @@index([ownerAssignmentId, ownershipRevision], map: "renewal_opportunities_owner_assignment_revision_idx")
