// --- Domain-axis memory (종축 도메인별 학습/기록) ---
// PolicyMemory 패턴을 GTM 도메인 축으로 확장. `domain` 컬럼이 단독-writer 소유 경계.

model DomainMemory {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  domain     String // GtmDomain: marketing|sales|presales|engineer|cfo
  memoryType String   @map("memory_type") // case | rule | exception
  key        String
  label      String
  tags       String[] @default([])
  valueJson  Json     @map("value_json")
  outcome    String? // approved | rejected | corrected
  source     String   @default("agent")
  confidence Int      @default(80)
  status     String   @default("active")
  embedding  Float[]  @default([]) // V2: semantic recall (app-layer cosine)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, domain, memoryType, key])
  @@index([projectId, domain, status])
  @@map("domain_memories")
}

enum DecisionActor {
  sales
  presales
  cfo
  marketing
  engineer
  commercial_approval
  deal_registration
  human
  ai

  @@map("decision_actor")
}

enum RiskTier {
  T0
  T1
  T2

  @@map("risk_tier")
}

model DomainDecisionLog {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  domain        String // GtmDomain
  caseRef       String?  @map("case_ref") // 연결된 산출물 id (Quote/Invoice 등)
  decisionType  String   @map("decision_type")
  inputJson     Json?    @map("input_json")
  outputJson    Json?    @map("output_json")
  colorGateJson Json?    @map("color_gate_json") // 통과/실패한 컬러 렌즈
  humanEditJson Json?    @map("human_edit_json") // 인간 반려/수정 (피드백 루프)
  outcome       String? // approved | rejected | corrected
  createdAt     DateTime @default(now()) @map("created_at")

  // ── S1 신규(전부 nullable, 순수 추가) ──
  actor               DecisionActor? // 결정 주체(도메인 레인/횡단 게이트)
  actionType          String?        @map("action_type") // 레지스트리 상수로 통제(enum 아님)
  riskTier            RiskTier?      @map("risk_tier") // 결정 시점 티어 스냅샷
  policyVersion       String?        @map("policy_version") // riskTier 근거 정책 버전
  predictedConfidence Float?         @map("predicted_confidence")
  modelVersion        String?        @map("model_version")
  cost                Decimal?       @db.Decimal(10, 4)
  rollbackOf          String?        @map("rollback_of") // 되돌림/소급취소 신호
  resolvedAt          DateTime?      @map("resolved_at")
  resolvedBy          String?        @map("resolved_by")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, domain, decisionType, createdAt])
  @@index([domain, caseRef])
  @@index([actor, actionType, createdAt]) // S1: 캘리브레이션 groupBy
  @@map("domain_decision_logs")
}

