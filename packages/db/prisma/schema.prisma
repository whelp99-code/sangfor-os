  releaseReference  String?  @map("release_reference")
  createdAt         DateTime @default(now()) @map("created_at")

  assessment AiQualityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict, map: "ai_model_snapshots_assessment_id_fkey")

