  @@index([assetId])
  @@index([endDate, status])
  @@index([deliveryAcceptanceId], map: "subscriptions_delivery_acceptance_id_idx")
  @@index([sourceQuoteLineItemId], map: "subscriptions_source_quote_line_item_id_idx")
  @@map("subscriptions")
}

model MaintenanceContract {
  id        String    @id @default(cuid())
  assetId   String    @map("asset_id")
  vendor    String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  status    String    @default("active")

  asset CustomerAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("maintenance_contracts")
}

