  contentHash             String   @map("content_hash")
  effectiveAt             DateTime @map("effective_at")
  retiredAt               DateTime? @map("retired_at")
  createdAt               DateTime @default(now()) @map("created_at")

  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict, map: "support_sla_policy_versions_company_id_fkey")
  policy              SupportSlaPolicy         @relation("SupportSlaPolicyVersions", fields: [policyId, companyId], references: [id, companyId], onDelete: Restrict, map: "support_sla_policy_versions_policy_company_fkey")
  currentForPolicies  SupportSlaPolicy[]       @relation("SupportSlaPolicyCurrentVersion")
