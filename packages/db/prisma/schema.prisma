  submissionEvidenceVendorEscalations VendorEscalation[] @relation("VendorEscalationSubmissionEvidenceArtifactVersion")
  deliveryAcceptances      DeliveryAcceptance[]  @relation("DeliveryAcceptanceArtifactVersion")
