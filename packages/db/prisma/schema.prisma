  @@unique([id, companyId], map: "support_sla_policy_versions_id_company_id_key")
  @@unique([policyId, version], map: "support_sla_policy_versions_policy_id_version_key")
  @@index([companyId, policyId], map: "support_sla_policy_versions_company_id_policy_id_idx")
  @@map("support_sla_policy_versions")
}

