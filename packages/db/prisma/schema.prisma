// AI Automation Work Portal — DB Kernel (Phase 1)
// Purpose: PostgreSQL multi-schema foundation for automation, audit, and UI registries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- core ---

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // U014/SEC-01: nullable lifecycle status, additive. NULL/"legacy_pending" are treated
  // identically as inactive by every runtime — the migration that introduced this column never
  // blanket-activates a pre-existing row. Only an explicitly reviewed provisioning path or the
  // synthetic local seed (packages/db/prisma/seed.ts) may write "active", and does so explicitly.
  // The named CHECK `users_status_lifecycle_check` (migration 20260715140000) enforces the
  // allowed value set plus the disabledAt/status coupling below at the DB layer; Prisma
  // optionality here is an ORM convenience, not the enforcement — the DB check is.
  status         String?   @default("legacy_pending") @map("status")
  disabledAt     DateTime? @map("disabled_at")
  disabledReason String?   @map("disabled_reason")

  projectMembers     ProjectMember[]
  commandRuns        CommandRun[]    @relation("CommandRunRequestedBy")
  userCompanyRoles   UserCompanyRole[]
  assignedCompanyRoles UserCompanyRole[] @relation("UserCompanyRoleAssignedBy")
  // TODO(oma-deferred): owner will expand to Actor union (User | TeamAgent) in a future migration
  ownedOpportunities Opportunity[]
  authSessions       AuthSession[]
  credential         UserCredential?

  @@map("users")
}

model UserCredential {
  userId              String    @id @map("user_id")
  passwordDigest      String    @map("password_digest")
  credentialVersion   Int       @default(1) @map("credential_version")
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastAuthenticatedAt DateTime? @map("last_authenticated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  commandRuns CommandRun[]
  mailInsightThreads MailInsightThread[]
  policyMemories     PolicyMemory[]
  policyDecisionLogs PolicyDecisionLog[]
  domainMemories     DomainMemory[]
  domainDecisionLogs DomainDecisionLog[]
  authSessions       AuthSession[]
  artifacts          Artifact[]
  approvalRequests   ApprovalRequest[]
  workflowDefinitions WorkflowDefinition[]
  workflowRuns        WorkflowRun[]
  auditLogs           AuditLog[]
  retentionRunItems RetentionRunItem[]
  aiExecutions AiExecution[]


  // U012: companyId stays optional here (full NOT NULL is deferred to U073 — see
  // packages/db/src/scope-closure.ts) because a live legacy-null Project can be a genuinely
  // pending U011 quarantine decision, not a defect. The DB layer still forbids new unscoped rows
  // via the named, validated CHECK `projects_company_id_required_for_new_rows_check` added in
  // migration 20260715120000 (a row created before that migration's watermark is grandfathered;
  // any row created at or after it must carry a companyId). Prisma optionality is therefore an
  // ORM-level convenience, not the closure guarantee — the DB check is.
  @@unique([companyId, id], map: "projects_company_id_id_key")
  @@index([companyId])
  @@map("projects")
}

// U015/SEC-02a: the project-assignment counterpart of UserCompanyRole's lifecycle columns, same
// fail-closed rules — NULL/"legacy_pending" rows confer no project authority and are never
// bulk-promoted by the migration that adds them. Company role and project assignment stay distinct
// concepts (no FK between this model and UserCompanyRole); `role` here keeps its pre-existing,
// unconstrained project-tier meaning (e.g. "member") and is not restricted to the ten BusinessRole
// codes.
model ProjectMember {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  userId    String    @map("user_id")
  role      String    @default("member")
  status    String?   @default("legacy_pending") @map("status")
  validFrom DateTime? @map("valid_from")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@map("project_members")
}

model Workspace {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("workspaces")
}

model ConfigProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  values ConfigValue[]

  @@map("config_profiles")
}

model ConfigValue {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  key       String
  valueJson Json     @map("value_json")
  createdAt DateTime @default(now()) @map("created_at")

  profile ConfigProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@map("config_values")
}

// --- automation (execution chain) ---

model Command {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  runs CommandRun[]

  @@map("commands")
}

model CommandRun {
  id              String   @id @default(cuid())
  commandId       String   @map("command_id")
  projectId       String   @map("project_id")
  requestedById   String?  @map("requested_by_id")
  status          String   @default("pending")
  inputSummary    String?  @map("input_summary")
  sourceEntityType String? @map("source_entity_type")
  sourceEntityId   String? @map("source_entity_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  command     Command    @relation(fields: [commandId], references: [id])
  project     Project    @relation(fields: [projectId], references: [id])
  requestedBy User?      @relation("CommandRunRequestedBy", fields: [requestedById], references: [id])
  workflows   Workflow[]
  intent      IntentAnalysis?
  risk        RiskAnalysis?
  codeChanges CodeChange[] @relation("CommandRunCodeChanges")
  skillRuns   SkillRun[]
  workBreakdownItems WorkBreakdownItem[]
  improvementCandidates ImprovementCandidate[]

  @@index([projectId, status])
  @@index([commandId])
  @@index([sourceEntityType, sourceEntityId])
  @@map("command_runs")
}

model ImprovementCandidate {
  id              String   @id @default(cuid())
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id")
  title           String
  summary         String
  severity        String   @default("medium")
  suggestedModule String?  @map("suggested_module")
  suggestedAction String?  @map("suggested_action")
  status          String   @default("proposed")
  commandRunId    String?  @map("command_run_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commandRun CommandRun? @relation(fields: [commandRunId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("improvement_candidates")
}

model Workflow {
  id           String   @id @default(cuid())
  commandRunId String   @map("command_run_id")
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  commandRun CommandRun      @relation(fields: [commandRunId], references: [id], onDelete: Cascade)
  steps      WorkflowStep[]

  @@index([commandRunId])
  @@map("workflows")
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  stepKey    String   @map("step_key")
  status     String   @default("pending")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workflow          Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentAssignments  AgentAssignment[]
  validationResults ValidationResult[]

  @@index([workflowId, sortOrder])
  @@map("workflow_steps")
}

model AgentAssignment {
  id             String   @id @default(cuid())
  workflowStepId String   @map("workflow_step_id")
  agentKey       String   @map("agent_key")
  status         String   @default("assigned")
  createdAt      DateTime @default(now()) @map("created_at")

  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]
  messages     AgentMessage[]
  decisions    AgentDecisionLog[]

  @@index([workflowStepId])
  @@map("agent_assignments")
}

model ToolCall {
  id                String   @id @default(cuid())
  agentAssignmentId String   @map("agent_assignment_id")
  toolKey           String   @map("tool_key")
  status            String   @default("pending")
  errorJson         Json?    @map("error_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agentAssignment AgentAssignment @relation(fields: [agentAssignmentId], references: [id], onDelete: Cascade)

  @@index([agentAssignmentId])
  @@map("tool_calls")
}

model ValidationResult {
  id             String   @id @default(cuid())
  workflowStepId String   @map("workflow_step_id")
  checkKey       String   @map("check_key")
  status         String
  detailsJson    Json?    @map("details_json")
  createdAt      DateTime @default(now()) @map("created_at")

  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  reports      Report[]

  @@index([workflowStepId])
  @@map("validation_results")
}

model Report {
  id                 String   @id @default(cuid())
  validationResultId String   @map("validation_result_id")
  title              String
  bodyMarkdown       String?  @map("body_markdown")
  createdAt          DateTime @default(now()) @map("created_at")

  validationResult ValidationResult @relation(fields: [validationResultId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model IntentAnalysis {
  id           String   @id @default(cuid())
  commandRunId String   @unique @map("command_run_id")
  summary      String
  intentJson   Json     @map("intent_json")
  createdAt    DateTime @default(now()) @map("created_at")

  commandRun CommandRun @relation(fields: [commandRunId], references: [id], onDelete: Cascade)

  @@map("intent_analyses")
}

model RiskAnalysis {
  id           String   @id @default(cuid())
  commandRunId String   @unique @map("command_run_id")
  riskLevel    String   @map("risk_level")
  riskJson     Json     @map("risk_json")
  createdAt    DateTime @default(now()) @map("created_at")

  commandRun CommandRun @relation(fields: [commandRunId], references: [id], onDelete: Cascade)

  @@map("risk_analyses")
}

model AgentMessage {
  id                String   @id @default(cuid())
  agentAssignmentId String   @map("agent_assignment_id")
  role              String
  content           String
  createdAt         DateTime @default(now()) @map("created_at")

  agentAssignment AgentAssignment @relation(fields: [agentAssignmentId], references: [id], onDelete: Cascade)

  @@index([agentAssignmentId])
  @@map("agent_messages")
}

model AgentDecisionLog {
  id                String   @id @default(cuid())
  agentAssignmentId String   @map("agent_assignment_id")
  decision          String
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  agentAssignment AgentAssignment @relation(fields: [agentAssignmentId], references: [id], onDelete: Cascade)

  @@index([agentAssignmentId])
  @@map("agent_decision_logs")
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  commandRunId  String?  @map("command_run_id")
  pullRequestId String?  @map("pull_request_id")
  status        String   @default("pending")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  // U018/APR-01a: nullable-for-expand scope + version-bound approval fields. Canonical
  // (legacyUnbound=false) rows require every field below non-null and mutually consistent — see
  // the named approval_requests_canonical_shape_guard trigger (migration 20260715180000). Legacy
  // (legacyUnbound=true, the DB default) rows — the unchanged pre-U022 approval-db.ts insert
  // shape — leave every one of these NULL and confer zero canonical authority.
  tenantId  String? @map("tenant_id")
  companyId String? @map("company_id")
  projectId String? @map("project_id")

  artifactVersionId    String? @map("artifact_version_id")
  action               String?
  artifactHashSnapshot String? @map("artifact_hash_snapshot")

  // Immutable after insert (guard trigger enforces this — never Prisma optionality alone).
  requestedByAssignmentId String? @map("requested_by_assignment_id")
  requestedSessionId      String? @map("requested_session_id")

  // Mutable CAS pair: U059's compare-and-swap target. The guard trigger requires
  // ownershipRevision to increment by exactly 1 whenever ownerAssignmentId changes, and to stay
  // unchanged otherwise — same rule as Artifact's owner CAS (migration 20260715170000).
  ownerAssignmentId String? @map("owner_assignment_id")
  ownershipRevision Int     @default(0) @map("ownership_revision")

  policyKey     String? @map("policy_key")
  policyVersion String? @map("policy_version")
  policyHash    String? @map("policy_hash")

  // DB-generated-compatible: the named BEFORE INSERT/UPDATE trigger
  // approval_request_validation_snapshot_guard fills validationSnapshotHash from
  // validationSnapshot via sangfor_validation_snapshot_sha256() when omitted, requires equality
  // when the caller supplies it, and denies any UPDATE that changes either field.
  validationSnapshot     Json?   @map("validation_snapshot")
  validationSnapshotHash String? @map("validation_snapshot_hash")

  requiredQuorum Int? @map("required_quorum")

  // Decision/state CAS counter — separate from and semantically independent of
  // ownershipRevision. No forced-increment rule exists at this unit (U022 owns that runtime).
  revision Int @default(0)

  expiresAt  DateTime? @map("expires_at")
  resolvedAt DateTime? @map("resolved_at")

  // Required, DB default TRUE. The unchanged pre-U022 approval-db.ts insert omits this column
  // entirely, so every legacy row keeps the DB default of true. U022 is the only card allowed to
  // insert a legacyUnbound=false row (never upgrades an existing legacy-unbound row in place).
  legacyUnbound Boolean  @default(true) @map("legacy_unbound")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "approval_requests_tenant_id_fkey")
  // U012-compatible composite scope-closure FKs (companies_tenant_id_id_key /
  // projects_company_id_id_key), same pattern as AuthSession/Artifact.
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, map: "approval_requests_company_id_fkey")
  project Project? @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, map: "approval_requests_project_id_fkey")

  artifactVersion ArtifactVersion? @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict, map: "approval_requests_artifact_version_id_fkey")

  // Distinct exact U012 composite assignment relations (user_company_roles_id_company_id_key) —
  // never an ID-only assignment FK, same pattern as Artifact's createdByAssignment/ownerAssignment.
  requestedByAssignment UserCompanyRole? @relation("ApprovalRequestedByAssignment", fields: [requestedByAssignmentId, companyId], references: [id, companyId], onDelete: Restrict, map: "approval_requests_requested_by_assignment_id_fkey")
  ownerAssignment       UserCompanyRole? @relation("ApprovalOwnerAssignment", fields: [ownerAssignmentId, companyId], references: [id, companyId], onDelete: Restrict, map: "approval_requests_owner_assignment_id_fkey")

  decisions       ApprovalDecision[]
  currentValidity ApprovalCurrentValidity?
  roleChangeRequest RoleChangeRequest?
  discountRequests DiscountRequest[]
  aiReleaseEvaluations AiReleaseEvaluation[]
  retentionRuns RetentionRun[] @relation("RetentionRunApprovalRequest")
  dataExportRequests DataExportRequest[] @relation("DataExportRequestApprovalRequest")
  metricBenchmarkVersions MetricBenchmarkVersion[] @relation("MetricBenchmarkVersionApprovalRequest")


  @@index([status])
  @@map("approval_requests")
}

// Append-only: UPDATE/DELETE denied by sangfor_approval_decisions_deny_update_trg /
// sangfor_approval_decisions_deny_delete_trg (reusing the existing sangfor_deny_mutation()
// function from migration 20260715170000). CHILD_VIA_FK through mandatory approvalRequestId only
// — no redundant companyId column; the named sangfor_approval_decision_guard_trg insert trigger
// joins approvalRequestId -> approval_requests.company_id and rejects an actorAssignmentId
// outside that company, and also rejects any decision recorded against a legacyUnbound=true
// parent (that request has no canonical scope/version/hash to record against).
model ApprovalDecision {
  id                String @id @default(cuid())
  approvalRequestId String @map("approval_request_id")

  sequence        Int
  requestRevision Int @map("request_revision")

  artifactVersionId    String @map("artifact_version_id")
  artifactHashSnapshot String @map("artifact_hash_snapshot")

  decision String

  actorAssignmentId  String  @map("actor_assignment_id")
  actorSessionId     String  @map("actor_session_id")
  actorRoleSnapshot  String  @map("actor_role_snapshot")
  policyHashSnapshot String  @map("policy_hash_snapshot")
  reason             String?

  createdAt DateTime @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "approval_decisions_approval_request_id_fkey")

  @@unique([approvalRequestId, sequence], map: "approval_decisions_approval_request_id_sequence_key")
  @@unique([approvalRequestId, actorAssignmentId], map: "approval_decisions_approval_request_id_actor_assignment_id_key")
  @@map("approval_decisions")
}

// One-to-one MUTABLE projection, deliberately separate from the append-only ApprovalDecision
// history above. Migration/backfill creates no row here at all (let alone state=valid); U022 is
// the only runtime allowed to execute the pending -> valid|invalid|stale|expired,
// valid -> stale|expired|revoked transitions — the named guard trigger enforces the graph plus
// the valid/invalid/expired structural preconditions regardless of which unit writes it.
model ApprovalCurrentValidity {
  approvalRequestId String @id @map("approval_request_id")

  requestRevision      Int    @map("request_revision")
  artifactVersionId    String @map("artifact_version_id")
  artifactHashSnapshot String @map("artifact_hash_snapshot")
  policyHashSnapshot   String @map("policy_hash_snapshot")

  requiredQuorum       Int @map("required_quorum")
  satisfiedQuorum      Int @map("satisfied_quorum")
  lastDecisionSequence Int @map("last_decision_sequence")

  state String

  evaluatedAt   DateTime? @map("evaluated_at")
  validUntil    DateTime? @map("valid_until")
  invalidatedAt DateTime? @map("invalidated_at")
  reasonCode    String?   @map("reason_code")

  updatedAt DateTime @updatedAt @map("updated_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "approval_current_validity_approval_request_id_fkey")

  @@map("approval_current_validity")
}

// --- dev ---

model Repository {
  id        String   @id @default(cuid())
  slug      String   @unique
  remoteUrl String?  @map("remote_url")
  createdAt DateTime @default(now()) @map("created_at")

  pullRequests PullRequest[]
  branches     Branch[]

  @@map("repositories")
}

model Branch {
  id           String   @id @default(cuid())
  repositoryId String   @map("repository_id")
  name         String
  headSha      String?  @map("head_sha")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@map("branches")
}

model PullRequest {
  id           String   @id @default(cuid())
  repositoryId String   @map("repository_id")
  number       Int
  title        String
  status       String   @default("open")
  url          String?
  ciStatus     String?  @map("ci_status")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  codeChanges CodeChange[]

  @@unique([repositoryId, number])
  @@map("pull_requests")
}

model CodeChange {
  id            String   @id @default(cuid())
  pullRequestId String?  @map("pull_request_id")
  commandRunId  String?  @map("command_run_id")
  summary       String
  createdAt     DateTime @default(now()) @map("created_at")

  pullRequest PullRequest?  @relation(fields: [pullRequestId], references: [id])
  commandRun  CommandRun?   @relation("CommandRunCodeChanges", fields: [commandRunId], references: [id])
  changedFiles ChangedFile[]
  buildRuns   BuildRun[]

  @@index([commandRunId])
  @@map("code_changes")
}

model BuildRun {
  id           String   @id @default(cuid())
  codeChangeId String?  @map("code_change_id")
  commandRunId String?  @map("command_run_id")
  status       String   @default("pending")
  logSummary   String?  @map("log_summary")
  createdAt    DateTime @default(now()) @map("created_at")

  codeChange CodeChange? @relation(fields: [codeChangeId], references: [id])
  testRuns   TestRun[]

  @@index([commandRunId])
  @@map("build_runs")
}

model TestRun {
  id           String   @id @default(cuid())
  buildRunId   String?  @map("build_run_id")
  commandRunId String?  @map("command_run_id")
  status       String   @default("pending")
  passed       Int      @default(0)
  failed       Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  buildRun BuildRun? @relation(fields: [buildRunId], references: [id])

  @@index([commandRunId])
  @@map("test_runs")
}

model ChangedFile {
  id           String @id @default(cuid())
  codeChangeId String @map("code_change_id")
  path         String
  changeType   String @map("change_type")

  codeChange CodeChange @relation(fields: [codeChangeId], references: [id], onDelete: Cascade)

  @@index([codeChangeId])
  @@map("changed_files")
}

// --- ui / module registry ---

model ModuleRegistry {
  id             String   @id @default(cuid())
  moduleKey      String   @unique @map("module_key")
  displayName    String   @map("display_name")
  version        String   @default("0.1.0")
  dependencyJson Json?    @map("dependency_json")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  blocks BlockRegistry[]
  nodes  NodeRegistry[]

  @@map("module_registry")
}

model BlockRegistry {
  id          String   @id @default(cuid())
  blockKey    String   @unique @map("block_key")
  moduleKey   String   @map("module_key")
  displayName String   @map("display_name")
  configJson  Json?    @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")

  module      ModuleRegistry @relation(fields: [moduleKey], references: [moduleKey])
  layoutSlots LayoutSlot[]

  @@index([moduleKey])
  @@map("block_registry")
}

model LayoutSlot {
  id              String  @id @default(cuid())
  pageKey         String  @map("page_key")
  slotKey         String  @map("slot_key")
  sortOrder       Int     @default(0) @map("sort_order")
  blockRegistryId String? @map("block_registry_id")

  block BlockRegistry? @relation(fields: [blockRegistryId], references: [id])

  @@unique([pageKey, slotKey])
  @@index([pageKey, sortOrder])
  @@map("layout_slots")
}

model NodeRegistry {
  id         String   @id @default(cuid())
  nodeKey    String   @unique @map("node_key")
  moduleKey  String   @map("module_key")
  nodeType   String   @map("node_type")
  configJson Json?    @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")

  module ModuleRegistry @relation(fields: [moduleKey], references: [moduleKey])

  @@index([moduleKey])
  @@map("node_registry")
}

model QueryRegistry {
  id          String   @id @default(cuid())
  queryKey    String   @unique @map("query_key")
  sourceType  String   @map("source_type")
  configJson  Json     @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("query_registry")
}

// --- audit (required for all state changes / async) ---

model StateTransitionLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
