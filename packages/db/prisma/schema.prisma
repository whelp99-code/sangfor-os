  @@unique([tenantId, id], map: "companies_tenant_id_id_key")
  @@index([tenantId])
  @@map("companies")
}

// U014/SEC-01: persisted principal/session lifecycle. `id` IS the JWT `jti` (never a separate
// surrogate key) — the whole point is that a cryptographically valid session-JWT is no longer
// sufficient on its own; Web Proxy / API middleware resolve `jti` to exactly this row. No raw JWT
// is ever stored (only identity/scope/lifecycle metadata). Registered once in
// packages/db/src/scope-inventory.ts as PROJECT_ROOT (U014) — tenant/company/project are all
// mandatory trusted scope roots on the session simultaneously, which would be an AMBIGUOUS_ROOT
// CHILD_VIA_FK chain; declaring it a root itself is the correct, structurally-checked category.
model AuthSession {
  id            String    @id
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  companyId     String    @map("company_id")
  projectId     String    @map("project_id")
  issuedAt      DateTime  @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")
  mfaMethod     String?   @map("mfa_method")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, map: "auth_sessions_user_id_fkey")
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "auth_sessions_tenant_id_fkey")
  // Composite FKs follow U012's scope-closure constraints (companies_tenant_id_id_key /
  // projects_company_id_id_key): companyId must actually belong to tenantId, and projectId must
  // actually belong to companyId — a forged/mismatched scope combination is rejected by Postgres
  // itself, not only by the application-level scope-mismatch check in evaluateSession().
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, map: "auth_sessions_company_id_fkey")
  project Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, map: "auth_sessions_project_id_fkey")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// U015/SEC-02a: nullable lifecycle columns, additive (same pattern as U014's users_status_lifecycle_check).
// NULL/"legacy_pending" rows are inactive and are never bulk-promoted by the migration that adds
// these columns. The named CHECK `user_company_roles_status_lifecycle_check` (migration
// 20260715150000) enforces the allowed value set; `user_company_roles_role_ten_codes_for_new_rows_check`
// constrains `role` to the ten @sangfor/auth BusinessRole codes for any row created at/after that
// migration's watermark, grandfathering pre-existing rows (including the campaign's own synthetic
// `role: "member"` fixtures) rather than retroactively rejecting them.
model UserCompanyRole {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  companyId    String    @map("company_id")
  role         String
  status       String?   @default("legacy_pending") @map("status")
  validFrom    DateTime? @map("valid_from")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  assignedById String?   @map("assigned_by_id")
  revision     Int       @default(0) @map("revision")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("UserCompanyRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  // U017: the two distinct Artifact composite-assignment relations, using this row's own
  // (id, companyId) composite unique key below — never an ID-only assignment FK.
  createdArtifacts Artifact[] @relation("ArtifactCreatedByAssignment")
  ownedArtifacts   Artifact[] @relation("ArtifactOwnerAssignment")
  // U018/APR-01a: the two distinct ApprovalRequest composite-assignment relations, same
  // (id, companyId) composite unique key — never an ID-only assignment FK.
  requestedApprovalRequests ApprovalRequest[] @relation("ApprovalRequestedByAssignment")
  ownedApprovalRequests     ApprovalRequest[] @relation("ApprovalOwnerAssignment")
  targetRoleChangeRequests    RoleChangeRequest[] @relation("RoleChangeTargetMembership")
  requestedRoleChangeRequests RoleChangeRequest[] @relation("RoleChangeRequestedByAssignment")
  appliedRoleChangeRequests   RoleChangeRequest[] @relation("RoleChangeAppliedByAssignment")
  // U019/WF-01a: the two distinct WorkflowDefinition/WorkflowRun composite-assignment relations,
  // same (id, companyId) composite unique key — never an ID-only assignment FK.
  createdWorkflowDefinitions WorkflowDefinition[] @relation("WorkflowDefinitionCreatedByAssignment")
  requestedWorkflowRuns      WorkflowRun[]        @relation("WorkflowRunRequestedByAssignment")
  ownedOpportunities         Opportunity[]        @relation("OpportunityOwnerAssignment")
  ownedWorkTasks             WorkTask[]           @relation("WorkTaskOwnerAssignment")
  assessedDealQualifications DealQualification[]  @relation("DealQualificationAssessedByAssignment")
  requestedDiscountRequests  DiscountRequest[]    @relation("DiscountRequestRequestedByAssignment")
  requestedVendorRequests    VendorRequest[]      @relation("VendorRequestRequestedByAssignment")
  ownedVendorRequests        VendorRequest[]      @relation("VendorRequestOwnerAssignment")
  vendorRequestEvents        VendorRequestEvent[] @relation("VendorRequestEventActorAssignment")
  acceptedDeliveryAcceptances DeliveryAcceptance[] @relation("DeliveryAcceptanceAcceptedByAssignment")
  ownedRenewalOpportunities   RenewalOpportunity[] @relation("RenewalOpportunityOwnerAssignment")
  ownedSupportCases           SupportCase[] @relation("SupportCaseOwnerAssignment")
  engineerCertifications      EngineerCertification[] @relation("EngineerCertificationMembership")
  verifiedCertificationEvidence CertificationEvidence[] @relation("CertificationEvidenceVerifiedByAssignment")
  engineerSkills              EngineerSkill[] @relation("EngineerSkillMembership")
  verifiedEngineerSkills      EngineerSkill[] @relation("EngineerSkillVerifiedByAssignment")
  engineerAssignments         EngineerAssignment[] @relation("EngineerAssignmentMembership")
  assignedEngineerAssignments EngineerAssignment[] @relation("EngineerAssignmentAssignedByAssignment")
  assessedAiQualityAssessments AiQualityAssessment[] @relation("AiQualityAssessmentAssessedByAssignment")
  reviewedAiQualityReviews     AiQualityReview[]     @relation("AiQualityReviewReviewerAssignment")
  legalHoldsAsCustodian LegalHold[] @relation("LegalHoldCustodianAssignment")
  retentionRunsAsActor RetentionRun[] @relation("RetentionRunActorAssignment")
  requestedDataExportRequests DataExportRequest[] @relation("DataExportRequestRequestedByAssignment")
  artifactAccessEvents ArtifactAccessEvent[] @relation("ArtifactAccessEventActorAssignment")
  exportCapabilities ExportCapability[] @relation("ExportCapabilityRequesterAssignment")
  ownershipTransfersAsSource OwnershipTransfer[] @relation("OwnershipTransferSourceAssignment")
  ownershipTransfersAsSuccessor OwnershipTransfer[] @relation("OwnershipTransferSuccessorAssignment")
  ownershipTransfersAsRequester OwnershipTransfer[] @relation("OwnershipTransferRequestedByAssignment")
  ownershipTransfersAsApprover OwnershipTransfer[] @relation("OwnershipTransferApprovedByAssignment")
  ownershipTransferItemsBefore OwnershipTransferItem[] @relation("OwnershipTransferItemOwnerAssignment")
  ownershipTransferItemsAfter OwnershipTransferItem[] @relation("OwnershipTransferItemAfterOwnerAssignment")
  createdMetricDefinitions MetricDefinition[]
  createdAiExecutions AiExecution[]

  @@unique([userId, companyId, role])
  @@unique([id, companyId], map: "user_company_roles_id_company_id_key")
  @@index([userId, companyId, status])
  @@map("user_company_roles")
}

// U012: companyId is required (backed by the U011 reviewed backfill's zero-live-null proof — see
// packages/db/src/scope-closure.ts) with a validated FK; the model is now classified CHILD_VIA_FK
// of Company in packages/db/src/scope-inventory.ts (RECLASSIFIED_MODELS).
model RoleChangeRequest {
  id          String   @id @default(cuid())
  // These original fields remain query-compatible snapshots; approvedBy is never authority.
  userId      String   @map("user_id")
  fromRole    String   @map("from_role")
  toRole      String   @map("to_role")
  status      String   @default("legacy_unbound")
  requestedBy String   @map("requested_by")
  approvedBy  String?  @map("approved_by")
  companyId   String   @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")

  legacyUnbound              Boolean   @default(true) @map("legacy_unbound")
  legacyStatus               String?   @map("legacy_status")
  tenantId                   String?   @map("tenant_id")
  targetMembershipId         String?   @map("target_membership_id")
  requestedByAssignmentId    String?   @map("requested_by_assignment_id")
  expectedMembershipRevision Int?      @map("expected_membership_revision")
  artifactVersionId          String?   @unique @map("artifact_version_id")
  approvalRequestId          String?   @unique @map("approval_request_id")
  snapshotHash               String?   @map("snapshot_hash")
  policyVersion              String?   @map("policy_version")
  expiresAt                  DateTime? @map("expires_at")
  revision                   Int       @default(0)
  requestIdempotencyKey      String?   @map("request_idempotency_key")
  requestInputHash           String?   @map("request_input_hash")
  terminalAt                 DateTime? @map("terminal_at")
  terminalReasonCode         String?   @map("terminal_reason_code")
  appliedAt                  DateTime? @map("applied_at")
  appliedByAssignmentId      String?   @map("applied_by_assignment_id")
  appliedMembershipRevision  Int?      @map("applied_membership_revision")
  appliedApprovalRevision    Int?      @map("applied_approval_revision")
  appliedDecisionSequence    Int?      @map("applied_decision_sequence")
  // Lifecycle CAS is the only writer; this intentionally is not @updatedAt.
  updatedAt                  DateTime  @default(now()) @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "role_change_requests_tenant_id_fkey")
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  targetMembership UserCompanyRole? @relation("RoleChangeTargetMembership", fields: [targetMembershipId, companyId], references: [id, companyId], onDelete: Restrict, map: "role_change_requests_target_membership_id_fkey")
  requestedByAssignment UserCompanyRole? @relation("RoleChangeRequestedByAssignment", fields: [requestedByAssignmentId, companyId], references: [id, companyId], onDelete: Restrict, map: "role_change_requests_requested_by_assignment_id_fkey")
  appliedByAssignment UserCompanyRole? @relation("RoleChangeAppliedByAssignment", fields: [appliedByAssignmentId, companyId], references: [id, companyId], onDelete: Restrict, map: "role_change_requests_applied_by_assignment_id_fkey")
  artifactVersion ArtifactVersion? @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict, map: "role_change_requests_artifact_version_id_fkey")
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, map: "role_change_requests_approval_request_id_fkey")
  ownershipTransfer OwnershipTransfer?

  @@index([userId, status])
  @@index([companyId])
  @@map("role_change_requests")
}

model Persona {
