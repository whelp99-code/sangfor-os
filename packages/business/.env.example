# packages/business env vars.
# DATABASE_URL is consumed via @sangfor/db and documented in the root
# .env.example — this file documents the rest of what packages/business's
# own source reads directly via process.env (grepped from src/).

DATABASE_URL="postgresql://ai_portal:ai_portal@localhost:5434/ai_automation_portal?schema=public"

# MiMo OpenAI-compatible chat API (see root .env.example for the full
# token-plan vs pay-as-you-go base URL note)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://token-plan-sgp.xiaomimimo.com/v1"
OPENAI_MODEL="mimo-v2.5-pro"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_MAX_COMPLETION_TOKENS="2048"
OPENAI_TIMEOUT_MS="25000"

# opencode server (structured/tool-calling domain pipeline backend)
OPENCODE_BASE_URL="http://127.0.0.1:4096"
OPENCODE_PROVIDER="openai"
OPENCODE_MODEL="gpt-5"
# Basic-auth creds, only needed if `opencode serve` is password-protected
OPENCODE_SERVER_USER=""
OPENCODE_SERVER_PASSWORD=""

# Outlook (app-only client_credentials sync — see packages/business/src/outlook-sync.ts)
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT_ID=""

# Azure AD app registration (shared with Outlook)
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# Connector staging gate (mail-candidates.ts / action-connector-runtime.ts)
# mock: keys may be empty, connector calls use local/mock-safe fallbacks
# real: full credentials required for github/notion/outlook connectors
CONNECTOR_STAGING_MODE="mock"
GITHUB_TOKEN=""
SLACK_WEBHOOK_URL=""

# Optional Langfuse observability (no-op when unset)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Mail candidate classification: fall back to the legacy keyword-only
# classifier instead of the AI-assisted path. Set to "1" to enable.
MAIL_CANDIDATES_LEGACY_KNOWLEDGE_FALLBACK=""

# Phase 13 skill-runner tuning (see packages/business/src/skills/execution-profile.ts)
PHASE13_SKILL_DOC_MAX_CHARS="2000"
PHASE13_SKILL_CONCURRENCY="3"
# Set to "1" to run PM/AIOS skills against the live LLM instead of stubs
PHASE13_LLM_ALL="0"
# Deprecated — use executionProfile="smoke" from the API caller instead
PHASE13_SKILL_KEYS=""

# Set to "1" to run postgres-backed integration tests locally or in CI
CI_INTEGRATION="0"
