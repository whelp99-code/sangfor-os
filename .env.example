DATABASE_URL="postgresql://ai_portal:ai_portal@localhost:5434/ai_automation_portal?schema=public"
REDIS_URL="redis://localhost:6380"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Phase 1+ placeholders (empty OK for CI without secrets)
# JWT_SECRET no longer signs/verifies the session JWT (see USER_JWT_* below) —
# kept only for unrelated non-session consumers (e.g. apps/web dashboard API
# key hashing).
JWT_SECRET=""
# local_mock is accepted only with NODE_ENV=development|test and explicit bypass.
AUTH_PROFILE=""
AUTH_BYPASS_ENABLED="0"
# Production API preflight requires both service keys and a server-owned operator principal.
API_KEY=""
SANGFOR_OPERATOR_PRINCIPAL_ID=""
# Required when the USER_JWT_* keyring is configured (min 8 chars); login
# rejects without a matching password.
AUTH_DEMO_PASSWORD=""

# U013/SEC-01: unified session JWT (web cookie + Proxy + API bearer). Security
# Auth is the sole owner of key rotation for this keyring — no other team or
# automation may install/demote/retire an entry. Values below are non-secret
# placeholders; a real deployment's USER_JWT_KEYRING_JSON secretBase64Url
# values must never be committed.
USER_JWT_ACTIVE_KID=""
USER_JWT_KEYRING_JSON=""
USER_JWT_ROTATION_OWNER="security-auth"
USER_JWT_ISSUER="sangfor-os"
USER_JWT_AUDIENCE="sangfor-os-runtime"
USER_JWT_TTL_SECONDS="900"
USER_JWT_CLOCK_SKEW_SECONDS="30"

# U026/OPS-01 signed internal principals. Security Auth is the sole rotation
# owner. Each profile has an independent keyring; never copy a kid or secret
# between profiles. Keyrings use only non-secret placeholders here.
INTERNAL_PRINCIPAL_TTL_SECONDS="60"
INTERNAL_PRINCIPAL_CLOCK_SKEW_SECONDS="5"
INTERNAL_PRINCIPAL_ROTATION_OWNER="security-auth"
# FINANCE: issuer=sangfor-web audience=sangfor-api-finance subject=human_delegation capabilities=finance.read|finance.write|finance.approve_margin
INTERNAL_PRINCIPAL_FINANCE_ACTIVE_KID=""
INTERNAL_PRINCIPAL_FINANCE_KEYRING_JSON=""
# SCHEDULER: issuer=sangfor-scheduler audience=sangfor-web-scheduler service=sangfor-scheduler capability=agent.schedule.tick
INTERNAL_PRINCIPAL_SCHEDULER_ACTIVE_KID=""
INTERNAL_PRINCIPAL_SCHEDULER_KEYRING_JSON=""
# WORKFLOW: issuer=sangfor-mcp-workflow audience=sangfor-web-workflow service=sangfor-mcp-workflow capabilities=workflow.definition.create|workflow.definition.read|workflow.definition.activate|workflow.run.create|workflow.run.read|workflow.run.callback
INTERNAL_PRINCIPAL_WORKFLOW_ACTIVE_KID=""
INTERNAL_PRINCIPAL_WORKFLOW_KEYRING_JSON=""
# ENGINEER: issuer=sangfor-engineer-mcp audience=sangfor-web-external-action service=sangfor-engineer-mcp capability=external_action.receipt.consume
INTERNAL_PRINCIPAL_ENGINEER_ACTIVE_KID=""
INTERNAL_PRINCIPAL_ENGINEER_KEYRING_JSON=""
OPENAI_API_KEY=""
# MiMo OpenAI-compatible API — https://platform.xiaomimimo.com/docs/en-US/api/chat/openai-api
# Token Plan (Subscription): tp- key + token-plan-* base URL
# Pay-as-you-go (API Keys): sk- key + https://api.xiaomimimo.com/v1 (auto-resolved if mismatched)
OPENAI_BASE_URL="https://token-plan-sgp.xiaomimimo.com/v1"
OPENAI_MODEL="mimo-v2.5-pro"
# Optional: phase13 runtime tuning
# OPENAI_MAX_COMPLETION_TOKENS="2048"
# PHASE13_SKILL_DOC_MAX_CHARS="2000"
# PHASE13_SKILL_CONCURRENCY="3"
# PHASE13_LLM_ALL="0" # 1이면 PM/AIOS 전체 스킬을 live LLM으로 실행
# PHASE13_SKILL_KEYS is deprecated; use executionProfile="smoke" from API caller.

# Optional open-source knowledge stack
# db: use built-in Prisma chunk search only
# lightrag: try LightRAG first, then fall back to built-in search
KNOWLEDGE_BACKEND="db"
KNOWLEDGE_INGEST_ENABLED="false"
LIGHTRAG_BASE_URL="http://localhost:9621"
LIGHTRAG_TIMEOUT_MS="8000"
LIGHTRAG_QUERY_MODE="mix"
OLLAMA_BASE_URL="http://localhost:11434"
OPENKB_WORKDIR="/Users/jmpark/Documents/Playground/AIOS v1/knowledge"
GRAPHIFY_OUT="/Users/jmpark/Documents/Playground/AIOS v1/knowledge/graphify-out"

# Phase 11 connector staging gate
# mock: keys may be empty and connector calls use local/mock-safe fallbacks.
# real: scripts/check-staging-connectors.sh requires all connector credentials below.
CONNECTOR_STAGING_MODE="mock"
GITHUB_TOKEN=""
NOTION_API_KEY=""
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT_ID=""
CONNECTOR_RATE_LIMIT_PER_MINUTE="60"
CONNECTOR_TIMEOUT_MS="10000"

# Optional Langfuse observability (no-op when unset)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Optional Sentry APM (no-op when unset; required for v1.0.1 staging evidence)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Set to 1 to allow POST /api/ops/apm-test (staging/local only)
APM_TEST_ROUTE_ENABLED="0"

# Standalone Mail Intelligence OAuth check (release gate)
MAIL_OAUTH_BASE_URL="http://localhost:3010"

# Local APM bootstrap (optional): docker compose -f docker-compose.yml -f docker-compose.glitchtip.yml --profile apm up -d
# Then: bash ./scripts/setup-local-apm-evidence.sh  (writes gitignored .env.local)

# Set to 1 to run postgres/redis integration tests locally or in CI
# Dashboard API Key authentication (comma-separated keys; empty = open access)
DASHBOARD_API_KEYS=""
CI_INTEGRATION="0"

# CFO/finance API key (apps/api /api/cfo). In production (NODE_ENV=production)
# requests require x-api-key matching FINANCE_API_KEY; in development the API
# allows access without a key when none is configured. The web app forwards
# this same key from its server-side proxy, so set it identically for both.
FINANCE_API_KEY=""

# U002 containment: diagnostics require a server-derived operator context and
# GitHub/Popbill/CODEF/live mutations remain denied even when credentials exist.
# The only public service liveness routes are workflow /api/system/health,
# engineer bridge /health, and engineer operator /api/health/live.

# U006 process profile: local | test | production (inferred from NODE_ENV when unset)
SANGFOR_PROCESS_PROFILE=""
