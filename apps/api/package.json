{
  "name": "@sangfor/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.production.json",
    "build": "corepack pnpm --filter @sangfor/db db:generate && corepack pnpm typecheck && node scripts/build-production.mjs",
    "start": "node dist/index.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:production": "node --test --test-concurrency=1 scripts/build-production.test.mjs scripts/production-start.test.mjs"
  },
  "dependencies": {
    "@sangfor/api-utils": "workspace:*",
    "@sangfor/auth": "workspace:^",
    "@sangfor/business": "workspace:*",
    "@sangfor/config": "workspace:*",
    "@sangfor/db": "workspace:*",
    "@sangfor/infra": "workspace:*",
    "@sangfor/persona": "workspace:*",
    "@sangfor/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "jose": "^5.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "esbuild": "0.28.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
