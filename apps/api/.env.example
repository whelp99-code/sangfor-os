# apps/api env vars.
# Shared infra vars (DATABASE_URL, etc.) are consumed via @sangfor/db and
# live in the root .env.example — this file documents only what apps/api's
# own source reads directly via process.env (grepped from apps/api/src).

NODE_ENV="development"
API_PORT="3200"
# Allowed CORS origin for the web app calling this API directly (not via proxy)
CORS_ORIGIN="http://localhost:3110"

# Set to "1" to bypass request auth in local dev/tests. Never set in production.
AUTH_BYPASS_ENABLED=""

# Dev-only tenant/company fallback used when no auth context resolves one
DEFAULT_TENANT_ID="dev-tenant"
DEFAULT_COMPANY_ID="dev-company"

# LLM (OpenAI-compatible) — used by a couple of apps/api services directly;
# see packages/business/.env.example for the fuller LLM config surface
OPENAI_API_KEY=""
OPENAI_MODEL="mimo-v2.5-pro"

# CODEF (bank/card data aggregation connector)
CODEF_CLIENT_ID=""
CODEF_CLIENT_SECRET=""

# Popbill (전자세금계산서 발행 연동) — see plan §11-J; kept behind these creds
# being unset (service no-ops without them)
POPBILL_LINK_ID=""
POPBILL_SECRET_KEY=""
POPBILL_CORP_NUM=""
# "true" for Popbill's test/sandbox mode, unset or any other value for live
POPBILL_IS_TEST="true"

# Notion export sync
NOTION_API_KEY=""
NOTION_EXPORT_DIR=""

# Slack notifications
SLACK_BOT_TOKEN=""
SLACK_WEBHOOK_URL=""

# Outlook webhook subscription validation (arbitrary shared secret string)
WEBHOOK_CLIENT_STATE="aios-webhook"

# Set to "1" to run postgres-backed integration tests locally or in CI
CI_INTEGRATION="0"
