# apps/api env vars.
# Shared infra vars (DATABASE_URL, etc.) are consumed via @sangfor/db and
# live in the root .env.example — this file documents only what apps/api's
# own source reads directly via process.env (grepped from apps/api/src).

NODE_ENV="development"
API_PORT="3200"
# Allowed CORS origin for the web app calling this API directly (not via proxy)
CORS_ORIGIN="http://localhost:3110"

# Set together with AUTH_PROFILE=local_mock only in local dev/tests.
AUTH_BYPASS_ENABLED=""
AUTH_PROFILE=""

# U013/SEC-01: unified session JWT bearer verification — same USER_JWT_*
# contract/keyring as apps/web's cookie + Proxy (see apps/web/.env.example).
# Security Auth is the sole owner of rotation for this keyring; values here
# are non-secret placeholders only.
USER_JWT_ACTIVE_KID=""
USER_JWT_KEYRING_JSON=""
USER_JWT_ROTATION_OWNER="security-auth"
USER_JWT_ISSUER="sangfor-os"
USER_JWT_AUDIENCE="sangfor-os-runtime"
USER_JWT_TTL_SECONDS="900"
USER_JWT_CLOCK_SKEW_SECONDS="30"

# Production preflight requires both keys and a server-owned operator principal.
# Missing/short values, a bypass, or local_mock in production exits 78 before listen.
API_KEY=""
FINANCE_API_KEY=""
SANGFOR_OPERATOR_PRINCIPAL_ID=""

# Dev-only tenant/company fallback used when no auth context resolves one
DEFAULT_TENANT_ID="dev-tenant"
DEFAULT_COMPANY_ID="dev-company"

# LLM (OpenAI-compatible) — used by a couple of apps/api services directly;
# see packages/business/.env.example for the fuller LLM config surface
OPENAI_API_KEY=""
OPENAI_MODEL="mimo-v2.5-pro"

# CODEF (bank/card data aggregation connector)
CODEF_CLIENT_ID=""
CODEF_CLIENT_SECRET=""

# Popbill (전자세금계산서 발행 연동) — see plan §11-J; kept behind these creds
# being unset (service no-ops without them)
POPBILL_LINK_ID=""
POPBILL_SECRET_KEY=""
POPBILL_CORP_NUM=""
# "true" for Popbill's test/sandbox mode, unset or any other value for live
POPBILL_IS_TEST="true"

# U002 has no live override: Popbill/CODEF/tax-invoice external mutations are
# denied before adapter construction; diagnostics require an operator context.

# Notion export sync
NOTION_API_KEY=""
NOTION_EXPORT_DIR=""

# Slack notifications
SLACK_BOT_TOKEN=""
SLACK_WEBHOOK_URL=""

# Outlook webhook subscription validation (arbitrary shared secret string)
WEBHOOK_CLIENT_STATE="aios-webhook"

# Set to "1" to run postgres-backed integration tests locally or in CI
CI_INTEGRATION="0"

# U006 process profile: local | test | production (inferred from NODE_ENV when unset)
SANGFOR_PROCESS_PROFILE=""
