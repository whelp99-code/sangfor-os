# apps/web env vars.
# Shared infra vars consumed indirectly via @sangfor/db / @sangfor/business
# (DATABASE_URL, REDIS_URL, LANGFUSE_*, PHASE13_*, etc.) live in the root
# .env.example — this file documents only what apps/web's own source reads
# directly via process.env (grepped from apps/web/src).

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3101"

# Session auth — U013/SEC-01 unified HS256 session JWT (cookie + Proxy +
# API bearer, shared contract with apps/api). Missing/malformed keyring
# fails closed. Security Auth is the sole owner of rotation for this
# keyring; values here are non-secret placeholders only.
USER_JWT_ACTIVE_KID=""
USER_JWT_KEYRING_JSON=""
USER_JWT_ROTATION_OWNER="security-auth"
USER_JWT_ISSUER="sangfor-os"
USER_JWT_AUDIENCE="sangfor-os-runtime"
USER_JWT_TTL_SECONDS="900"
USER_JWT_CLOCK_SKEW_SECONDS="30"

# U026 signed internal-principal verifier/signer boundary. All profile
# keyrings are independent; values are non-secret placeholders only.
INTERNAL_PRINCIPAL_TTL_SECONDS="60"
INTERNAL_PRINCIPAL_CLOCK_SKEW_SECONDS="5"
INTERNAL_PRINCIPAL_ROTATION_OWNER="security-auth"
# FINANCE signer: sangfor-web -> sangfor-api-finance; human_delegation; finance.read|finance.write|finance.approve_margin
INTERNAL_PRINCIPAL_FINANCE_ACTIVE_KID=""
INTERNAL_PRINCIPAL_FINANCE_KEYRING_JSON=""
# SCHEDULER verifier: sangfor-scheduler -> sangfor-web-scheduler; service=sangfor-scheduler; agent.schedule.tick
INTERNAL_PRINCIPAL_SCHEDULER_ACTIVE_KID=""
INTERNAL_PRINCIPAL_SCHEDULER_KEYRING_JSON=""
# WORKFLOW verifier: sangfor-mcp-workflow -> sangfor-web-workflow; service=sangfor-mcp-workflow; workflow.definition.create|workflow.definition.read|workflow.definition.activate|workflow.run.create|workflow.run.read|workflow.run.callback
INTERNAL_PRINCIPAL_WORKFLOW_ACTIVE_KID=""
INTERNAL_PRINCIPAL_WORKFLOW_KEYRING_JSON=""
# ENGINEER verifier: sangfor-engineer-mcp -> sangfor-web-external-action; service=sangfor-engineer-mcp; external_action.receipt.consume
INTERNAL_PRINCIPAL_ENGINEER_ACTIVE_KID=""
INTERNAL_PRINCIPAL_ENGINEER_KEYRING_JSON=""
# U027 root-only external-action receipt signer. Do not place either value in
# the engineer workspace or return it from an API. Placeholders only.
EXTERNAL_ACTION_RECEIPT_ACTIVE_KEY_ID=""
EXTERNAL_ACTION_RECEIPT_KEYS_JSON=""
# JWT_SECRET no longer signs/verifies the session — kept only for the
# unrelated dashboard API-key hashing in src/lib/auth/api-key.ts.
JWT_SECRET=""
# Required when the USER_JWT_* keyring is configured (min 8 chars); login
# rejects without a match.
AUTH_DEMO_PASSWORD=""
# The fixed mock principal is allowed only with local_mock in development/tests.
AUTH_PROFILE=""
# Set to "1" to bypass ordinary route guards in development/tests only. This
# never creates an operator identity and is ignored in production.
AUTH_BYPASS_ENABLED=""

# apps/api (CFO/finance) proxy target + shared API key.
# FINANCE_API_KEY must match the same var on apps/api — the web server-side
# proxy forwards it as-is.
FINANCE_API_URL="http://localhost:3200/api/cfo"
CFO_API_URL=""
FINANCE_API_KEY=""
API_KEY=""

# Dashboard API-key auth for a few ops/dashboard routes (comma-separated
# keys; empty = open access in development).
DASHBOARD_API_KEYS=""

# Outlook OAuth (delegated mail sync — see docs/DEV_REFERENCE.md §3.F)
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT_ID=""
OUTLOOK_REDIRECT_URI="http://localhost:3101/api/mail/oauth/callback"
OUTLOOK_API_KEY=""

# Azure AD app registration (shared with the Outlook OAuth flow in some paths)
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# Connector tokens used by a few web routes directly
GITHUB_TOKEN=""
SLACK_WEBHOOK_URL=""

# Knowledge search backend
# db: built-in Prisma chunk search only
# lightrag: try LightRAG first, then fall back to built-in search
KNOWLEDGE_BACKEND="db"
KNOWLEDGE_INGEST_ENABLED="false"
LIGHTRAG_BASE_URL="http://localhost:9621"
LIGHTRAG_TIMEOUT_MS="8000"
LIGHTRAG_QUERY_MODE="mix"

# AIOS v3 bridge (F-aios-v3-core workflow/monitoring server + LM Studio local
# inference). Defaults match a local F-aios-v3-core + LM Studio bring-up.
AIOS_V3_DEBUG="false"
AIOS_V3_SERVER_URL="http://localhost:3201"
AIOS_V3_SERVER_TIMEOUT_MS="30000"
AIOS_V3_LM_STUDIO_URL="http://localhost:1234"
AIOS_V3_LM_STUDIO_TIMEOUT_MS="60000"

# Sentry APM (no-op when unset)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="staging"
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_ORG_SLUG=""
SENTRY_PROJECT_SLUG=""
# Set to "1" to allow POST /api/ops/apm-test (staging/local only)
APM_TEST_ROUTE_ENABLED="0"

# Set to "1" to run postgres/redis-backed integration tests locally or in CI
CI_INTEGRATION="0"

# U006 process profile: local | test | production (inferred from NODE_ENV when unset)
SANGFOR_PROCESS_PROFILE=""
