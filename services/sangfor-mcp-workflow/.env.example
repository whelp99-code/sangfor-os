# ─── Sangfor MCP Workflow — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.

# Authentication is fail-closed. Supply secrets out of band; never commit values.
# Mock/bypass modes are allowed only in explicit local tests and never grant production auth.
SANGFOR_API_KEY=
MCP_API_KEY=
SANGFOR_OPERATOR_PRINCIPAL_ID=
AUTH_BYPASS_ENABLED=0
API_KEY_BYPASS_ENABLED=0
WHELP99_ENFORCE_SAFE_TOOLS=true

# Public liveness is limited to these exact minimal responses:
# workflow operator GET /api/system/health
# engineer bridge GET /health
# engineer operator GET /api/health/live
# All diagnostics, metadata, APIs, and MCP methods require an operator context.
# Production defaults to deny when any required key, principal, or safety gate is absent.

# Engineer MCP repo path (device learn / workflow tool execution)
SANGFOR_MCP_CWD=/Users/me/Documents/Playground/whelp99-code-sangfor-engineer-mcp

# ─── Product Credentials (EPP / IAG / CC) ─────────────────────────────────────
EPP_USERNAME=admin
EPP_PASSWORD=
IAG_USERNAME=admin
IAG_PASSWORD=
CC_USERNAME=admin
CC_PASSWORD=

# CAPTCHA OCR — LM Studio vision (권장) 또는 Tesseract
# LM Studio 실행 + vision 모델 로드 (예: qwen/qwen3.5-9b)
LM_STUDIO_VISION_MODEL=qwen/qwen3.5-9b
LM_STUDIO_VISION_ENDPOINT=http://localhost:1234/v1/chat/completions
LM_STUDIO_API_KEY=lm-studio
# ─── Allowed File Directories (comma-separated) ───────────────────────────────
# Directories from which parse_excel can read files.
# Defaults to $HOME/Documents and the project working directory.
# ALLOWED_FILE_DIRS=/Users/me/Documents,/home/me/projects

# U006 process profile: local | test | production (inferred from NODE_ENV when unset)
SANGFOR_PROCESS_PROFILE=""

# ─── U028 canonical workflow-root adapter (non-secret placeholders) ───────────
# The workflow service never uses an ambient user token, local Maps, or a local
# approval fallback. These fixed U026 values are validated before authority use.
SANGFOR_ROOT_URL=https://sangfor-root.example.invalid
INTERNAL_PRINCIPAL_TTL_SECONDS=60
INTERNAL_PRINCIPAL_CLOCK_SKEW_SECONDS=5
INTERNAL_PRINCIPAL_ROTATION_OWNER=security-auth
INTERNAL_PRINCIPAL_WORKFLOW_ACTIVE_KID=workflow-current-kid
# JSON keyring is supplied by the rotation owner. Do not put a production key here.
INTERNAL_PRINCIPAL_WORKFLOW_KEYRING_JSON={"version":"sangfor.internal-principal-keyring/v1","keys":[{"kid":"workflow-current-kid","state":"active","secretBase64Url":"REPLACE_WITH_32_BYTE_BASE64URL_SECRET","activatedAt":"2026-01-01T00:00:00Z","demotedAt":null,"verificationCutoff":null,"retiredAt":null}]}

# Fixed WORKFLOW principal profile (not configurable)
# issuer=sangfor-mcp-workflow
# audience=sangfor-web-workflow
# service_id=sangfor-mcp-workflow
# capabilities=workflow.definition.create,workflow.definition.read,workflow.definition.activate,workflow.run.create,workflow.run.read,workflow.run.callback
# Authority route writers require a caller-owned absolute output root. It must
# be outside this repository and inside the task's declared attempt root.
SANGFOR_TASK_OUTPUT_ROOT=
SANGFOR_TASK_ATTEMPT_ROOT=
