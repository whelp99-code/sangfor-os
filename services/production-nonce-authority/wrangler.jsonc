{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "production-nonce-authority",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PRODUCTION_NONCE_CONSUMER",
        "class_name": "ProductionNonceConsumer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProductionNonceConsumer"]
    }
  ]
}
