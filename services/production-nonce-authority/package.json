    "build": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@types/node": "20.19.43",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.10",
    "wrangler": "4.86.0"
  }
}
