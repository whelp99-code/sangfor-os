<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jmpark.sangfor.mail-classify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/DevSpace/Playground/sangfor-os/scripts/launchd/run-cron.sh</string>
    <string>scripts/launchd/cron-call.mjs</string>
    <string>--path</string>
    <string>/api/mail-candidates</string>
    <string>--method</string>
    <string>POST</string>
    <string>--body</string>
    <string>{"limit":50}</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Volumes/DevSpace/Playground/sangfor-os/.agents/results/kpi/mail-classify.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/DevSpace/Playground/sangfor-os/.agents/results/kpi/mail-classify.launchd.err.log</string>
</dict>
</plist>
