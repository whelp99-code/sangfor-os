{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sangfor-detached-release-mirror-receipt-v1",
  "title": "DetachedReleaseMirrorReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "ownerUnit",
    "candidateSha",
    "mirrorPath",
    "mirrorHead",
    "detached",
    "sourceStatusBefore",
    "sourceStatusAfter",
    "originalWorktreesBefore",
    "originalWorktreesAfter",
    "originalIgnoredEnvBefore",
    "originalIgnoredEnvAfter",
    "envScanCheckpoints",
    "childEnvKeySets",
    "installs",
    "mode",
    "commands",
    "build",
    "start",
    "playwright",
    "cleanup",
    "result",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "ownerUnit": { "type": "string", "enum": ["U007", "U030", "U076"] },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "mirrorPath": { "type": "string", "minLength": 1 },
    "mirrorHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "detached": { "type": "boolean" },
    "sourceStatusBefore": { "type": "string" },
    "sourceStatusAfter": { "type": "string" },
    "originalWorktreesBefore": { "type": "array" },
    "originalWorktreesAfter": { "type": "array" },
    "originalIgnoredEnvBefore": { "type": "array" },
    "originalIgnoredEnvAfter": { "type": "array" },
    "envScanCheckpoints": { "type": "array" },
    "childEnvKeySets": { "type": "array" },
    "installs": { "type": "object" },
    "mode": {
      "type": "string",
      "enum": ["u007-release", "u030-post-release", "u076-final-aliases"]
    },
    "commands": { "type": "array" },
    "build": { "type": ["object", "null"] },
    "start": { "type": ["object", "null"] },
    "playwright": { "type": ["object", "null"] },
    "cleanup": { "type": "object" },
    "result": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
