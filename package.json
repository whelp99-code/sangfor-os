{
  "name": "sangfor-agentic-os",
  "version": "1.0.0",
  "private": true,
  "description": "Sangfor Agentic Company OS \u2014 \ud1b5\ud569 \ube44\uc988\ub2c8\uc2a4 \ud50c\ub7ab\ud3fc",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sangfor/db build && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @sangfor/web dev",
    "dev:finance": "pnpm --filter @sangfor/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:acceptance": "node scripts/run-playwright-acceptance.mjs",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "typecheck": "pnpm -r typecheck",
    "verify:release": "node scripts/verify-release.mjs --manifest scripts/release-gate.manifest.json",
    "db:generate": "pnpm --filter @sangfor/db db:generate",
    "db:push": "pnpm --filter @sangfor/db db:push",
    "db:migrate": "pnpm --filter @sangfor/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @sangfor/db db:migrate:deploy",
    "db:seed": "pnpm --filter @sangfor/db db:seed",
    "db:studio": "pnpm --filter @sangfor/db db:studio",
    "health:check": "bash scripts/health-check.sh",
    "mock:upstreams": "node scripts/mock-upstreams.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml up -d postgres redis",
    "cfo:snapshot": "pnpm --filter @sangfor/db cfo:snapshot",
    "db:push:safe": "pnpm --filter @sangfor/db cfo:snapshot || true; pnpm --filter @sangfor/db db:push"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma"
    ],
    "overrides": {
      "postcss": "8.5.10"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.4",
    "playwright": "^1.60.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
